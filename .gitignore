# ---------------------------------------------------------------------------
# Data: never committed
# ---------------------------------------------------------------------------
# MIMIC-IV is credentialed-access data (PhysioNet data use agreement) and is not redistributed via
# this repo. Obtain it separately and point MIMIC_DATA_DIR at it (see README). All local raw data
# lives under data/: the demo dataset (data/raw/mimic-iv-clinical-database-demo-2.2/) and the full
# MIMIC-IV 3.1 download (data/raw/mimic-iv-3.1-fulldataset/, ~12 GB).
data/

# Raw and intermediate data files anywhere else in the tree
*.csv.gz
*.gz
*.parquet
*.avro
*.orc
*.feather
*.arrow
*.dcm
*.zip
*.7z
*.tar
*.dump
*.bak

# Run logs (summaries are kept under docs/)
logs/*.log
# Ad hoc Glue debug captures saved at the repo root
/bootstrap_log*.txt
/*_out.txt
/*_err.txt

# ---------------------------------------------------------------------------
# Secrets and local configuration (see .env.example)
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
.envrc
.pypirc

# ---------------------------------------------------------------------------
# Python environments, caches, and build artifacts
# ---------------------------------------------------------------------------
.venv/
venv/
env/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/
*.egg-info/
build/
dist/

# ---------------------------------------------------------------------------
# Editor, tool, and OS files
# ---------------------------------------------------------------------------
.claude/
.vscode/
.idea/
.DS_Store
Thumbs.db
~$*
