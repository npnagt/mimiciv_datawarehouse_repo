# Copy to .env and fill in your AWS RDS connection details. Never commit .env.
# Used once the Aurora cluster already exists (see AWS provisioning section below
# for how to create it) -- these point `mimic-load load` / `create-staging` at it.

# Every AWS resource this repo provisions is tagged Project=<PROJECT_TAG> (S3 bucket,
# IAM roles, Aurora cluster, Glue jobs / connection) so spend can be split from the
# data-lakehouse repo (Project=LAKEHSE). Activate "Project" in Billing > Cost allocation tags.
PROJECT_TAG=DWHS

# --- Dataset selection -------------------------------------------------------------
# demodataset (100 patients, data/raw/mimic-iv-clinical-database-demo-2.2) or
# fulldataset (data/raw/mimic-iv-3.1-fulldataset). Also settable per invocation:
#   mimic-load --dataset fulldataset glue deploy
#   python scripts/run_end_to_end.py --dataset fulldataset
# Each dataset gets its OWN Aurora database, S3 source bucket and Glue jobs/roles
# (suffixed -demo / -full) inside the SHARED Aurora cluster, so both can be built
# side by side. Every name below still overrides its per-dataset default when set.
MIMIC_DATASET=demodataset

RDS_HOST=your-cluster.cluster-xxxxxxxxxx.us-east-2.rds.amazonaws.com
RDS_PORT=5432
# Leave RDS_DATABASE unset to follow MIMIC_DATASET (mimic4rds_demo / mimic4rds_full);
# set it only to pin one specific database regardless of --dataset.
# RDS_DATABASE=mimic4rds_demo
RDS_USER=mimic_admin

# "password" (default) uses RDS_PASSWORD below. Some AWS account tiers restrict Aurora
# to "express configuration" (no VPC control, no static password, IAM auth only) --
# aws.aurora.create_serverless_cluster falls back to that automatically and logs a
# warning when it happens. If it did, set RDS_AUTH_MODE=iam here; RDS_PASSWORD is then
# ignored and db.make_engine() generates a fresh IAM auth token per connection instead
# (your AWS credentials need rds-db:connect on the DB user).
RDS_AUTH_MODE=password
RDS_PASSWORD=change-me

# Root of the extracted dataset (contains hosp/ and icu/ subfolders). Leave unset to
# follow MIMIC_DATASET; set it only to point at a non-standard extract location.
# MIMIC_DATA_DIR=data/raw/mimic-iv-clinical-database-demo-2.2

# AWS credentials: uses the default credential chain (aws configure / instance role).
# Uncomment and set AWS_PROFILE only if you need a named profile -- leaving it set to
# an empty string (rather than omitted) makes boto3 look for a profile literally
# named "", which fails with ProfileNotFound.
# AWS_PROFILE=your-profile-name
AWS_REGION=us-east-2

# --- AWS infrastructure provisioning (scripts/build_datawarehouse.py, `mimic-load aws ...`) ---
# These create billed AWS resources -- an S3 bucket, IAM role, and an Aurora Serverless v2
# cluster. Review scripts/build_datawarehouse.py before running it.

# Leave S3_BUCKET_NAME / IAM_ROLE_NAME / AURORA_DB_NAME / the GLUE_* names unset to
# follow MIMIC_DATASET (each becomes *-demo / *-full). The Aurora CLUSTER is shared
# across datasets -- only the database inside it differs.
# S3_BUCKET_NAME=mimic4-dw-sourcefiles-demo
# IAM_ROLE_NAME=mimic4-aurora-s3-import-role-demo

AURORA_CLUSTER_ID=mimic4rds
# AURORA_DB_NAME=mimic4rds_demo
AURORA_MASTER_USERNAME=mimic_admin
AURORA_MASTER_PASSWORD=change-me
AURORA_MIN_ACU=0.5
AURORA_MAX_ACU=4

# Only used if your account supports standard VPC-attached clusters (PubliclyAccessible=
# False). You must already have a DB subnet group and security group(s) that permit
# Postgres (5432) access from wherever you'll connect (VPN/bastion/etc.) -- this project
# never opens a security group to the internet. Ignored entirely if the account falls
# back to express configuration (see RDS_AUTH_MODE above).
DB_SUBNET_GROUP_NAME=your-subnet-group
VPC_SECURITY_GROUP_IDS=sg-xxxxxxxxxxxxxxxxx

# --- AWS Glue provisioning (`mimic-load glue deploy` / `mimic-load glue run-*`) ---
# Runs the production ETL (schema bootstrap + staging load + warehouse dim/fact/aggregate
# load) as managed Glue jobs instead of the local `mimic-load load-staging` /
# `load-warehouse` commands (those stay available for local dev against a reachable
# Postgres). Job names are "<GLUE_JOB_NAME_PREFIX>-schema-bootstrap" / "-stg-load" /
# "-wh-dimensions" / "-wh-facts" / "-wh-aggregates" -- the "dw-etl" default plus each
# step's marker keeps them identifiable in an account/region shared with other projects'
# Glue jobs.
# GLUE_ROLE_NAME=mimic4-dw-etl-glue-role-demo
# GLUE_CONNECTION_NAME=mimic4-dw-etl-aurora-connection-demo
# GLUE_JOB_NAME_PREFIX=mimic4-dw-etl-demo
GLUE_WORKER_TYPE=G.1X
GLUE_NUM_WORKERS=2
GLUE_VERSION=4.0

# Only needed for a VPC-attached Aurora cluster (RDS_AUTH_MODE=password, standard
# `mimic-load aws create-cluster`) -- a Glue JDBC connection binds to one specific
# subnet/AZ (unlike DB_SUBNET_GROUP_NAME above, which spans several); pick one subnet
# from that same group so Glue's ENIs can reach the cluster, and the AZ it's in.
# Leave BOTH unset for an express-configuration cluster (RDS_AUTH_MODE=iam, no VPC,
# internet-reachable, required on free/low-tier accounts -- see README's "Running the
# ETL as AWS Glue jobs") -- Glue jobs then run in default networking and generate their
# own RDS IAM token at runtime; `mimic-load glue deploy` grants rds-db:connect for you.
GLUE_SUBNET_ID=subnet-xxxxxxxxxxxxxxxxx
GLUE_AVAILABILITY_ZONE=us-east-2a
